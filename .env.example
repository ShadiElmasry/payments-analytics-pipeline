# --- Default (local) mode needs no credentials. Paths are optional overrides. ---
# DBT_TARGET=duckdb
# DUCKDB_PATH=/absolute/path/to/data/warehouse.duckdb
# LAKE_PATH=/absolute/path/to/data/lake

# --- Snowflake mode (experimental) ---
# DBT_TARGET=snowflake
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=PAYMENTS_WH
SNOWFLAKE_DATABASE=PAYMENTS_DB
