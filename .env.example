# Copy this file to .env (never commit .env). Local DuckDB mode needs nothing from here.
# Snowflake mode only:  python -m payments.run_all --target snowflake
#
# Airflow in Docker: set this to snowflake so the DAG loads RAW and builds the dbt models in Snowflake
# (run_all ignores it and uses --target). After changing it: docker compose up -d
DBT_TARGET=duckdb
#
# Account identifier looks like <orgname>-<accountname> (Snowsight: your name > Account > copy account identifier)
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=PAYMENTS_SVC
# Full path to the private key created by scripts/make_snowflake_keys.py
SNOWFLAKE_PRIVATE_KEY_PATH=C:\Users\you\.snowflake\payments_rsa_key.p8
SNOWFLAKE_ROLE=PAYMENTS_ROLE
SNOWFLAKE_WAREHOUSE=PAYMENTS_WH
SNOWFLAKE_DATABASE=PAYMENTS_DB
